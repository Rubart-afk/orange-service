# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Set to 1 when the app runs behind one trusted reverse proxy.
TRUST_PROXY=
COOKIE_SECURE=0
OTKLIK_DB_PATH=./data/otklik.db
BACKUP_DIR=./backups
BACKUP_KEEP=14
LOG_REQUESTS=0

# Generate both values with: npm run generate:secrets
TOKEN_ENCRYPTION_KEY=
ADMIN_API_KEY=

# Google OAuth (the callback must exactly match the Google Console setting)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/email-accounts/callback/google

# Optional HTTPS endpoint for new tariff/support request notifications
REQUEST_WEBHOOK_URL=
